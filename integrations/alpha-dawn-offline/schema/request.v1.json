          "minItems": 0,
          "maxItems": 1000
        },
        "period": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            },
            "frequency": {
              "enum": [
                "annual",
                "interim",
                "quarterly",
                "instant"
