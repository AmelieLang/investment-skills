            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              },
              "frequency": {
                "enum": [
                  "annual",
                  "interim",
                  "quarterly",
                  "instant"
                ]
              }
            },
            "required": [
              "start",
              "end",
              "frequency"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 3
        },
        "latest_interim": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            },
            "frequency": {
              "enum": [
                "interim",
                "quarterly"
              ]
            }
          },
          "required": [
            "start",
            "end",
            "frequency"
          ],
          "additionalProperties": false
        },
        "calendar_basis_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.-]+",
            "maxLength": 150
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "policy_id",
        "mode",
        "frozen_at",
        "override_reason",
        "fiscal_years",
        "latest_interim",
        "calendar_basis_fact_ids"
      ],
      "additionalProperties": false
    },
    "requirement_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "[A-Za-z0-9_.-]+",
          "maxLength": 150
        },
        "minItems": 0,
        "maxItems": 1000
      }
    },
