      "properties": {
        "policy_id": {
          "const": "latest_three_fiscal_years_plus_latest_interim/v1"
        },
        "mode": {
          "enum": [
            "default",
            "case_specific"
          ]
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "override_reason": {
          "type": "string",
          "maxLength": 30000
        },
        "fiscal_years": {
          "type": "array",
