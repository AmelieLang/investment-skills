    "case_id",
    "bot_id",
    "operation",
    "cutoff_at",
    "valuation_date",
    "evaluated_at",
    "facts",
    "assumptions",
    "quality_window",
    "requirement_evidence",
    "quality_assessments",
    "contradictions",
    "hard_risks",
    "falsifiers",
    "security",
    "valuation",
    "native_output",
    "notes"
  ],
  "additionalProperties": false,
