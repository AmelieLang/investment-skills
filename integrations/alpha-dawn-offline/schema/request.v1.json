{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "offline-alpha-dawn/v1.1"
    },
    "case_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.-]+",
      "maxLength": 150
    },
    "bot_id": {
      "const": "alpha-dawn-framework"
    },
    "operation": {
      "enum": [
        "validate",
        "compute"
      ]
    },
    "cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "valuation_date": {
      "type": "string",
      "format": "date"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "minItems": 0,
      "maxItems": 1000
