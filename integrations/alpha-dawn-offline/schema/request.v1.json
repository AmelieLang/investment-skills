      "type": "array",
      "items": {
        "$ref": "#/$defs/judgment"
      },
      "minItems": 0,
      "maxItems": 5
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contradiction"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "hard_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hard"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "falsifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/falsifier"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "valuation": {
      "$ref": "#/$defs/valuation"
    },
    "native_output": {
