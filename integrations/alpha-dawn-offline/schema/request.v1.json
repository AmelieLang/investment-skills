        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "vintage_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_kind": {
          "enum": [
            "reported",
            "historical",
            "historical_stress",
            "hypothetical",
            "calculation"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
