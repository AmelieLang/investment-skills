        "intent": {
          "type": "string",
          "maxLength": 30000
        },
        "reason": {
          "type": "string",
          "maxLength": 30000
        },
        "raw_text": {
          "type": "string",
          "maxLength": 30000
        }
      },
      "required": [],
      "additionalProperties": {}
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 30000
      },
      "minItems": 0,
      "maxItems": 1000
    }
